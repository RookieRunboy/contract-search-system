# Copy this file to .env and fill in your own values.
CONTRACT_API_KEY=your_deepseek_api_key
# 通义千问多模态识别所需的 API Key（必填）
QWEN_API_KEY=your_dashscope_api_key
# 自定义接口地址（可选，默认为 https://dashscope.aliyuncs.com/compatible-mode/v1）
# QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# 覆盖默认模型（可选，默认为 qwen3-vl-30b-a3b-instruct）
# QWEN_MM_MODEL=qwen3-vl-30b-a3b-instruct

# JWT Token Expiration in minutes (optional, default 4320 minutes / 3 days)
AUTH_TOKEN_EXPIRE_MINUTES=4320
AUTH_SECRET_KEY=your_secret_key_change_in_production

# Upload Queue Configuration
# Maximum number of concurrent PDF processing tasks (default: 4, range: 1-10)
UPLOAD_MAX_CONCURRENT=4
# Minimum available memory (MB) to start new processing task (default: 512)
UPLOAD_MIN_MEMORY_MB=512

# PDF Batch Processing Configuration
# Number of PDF pages to load per batch (default: 5, range: 1-20)
# Smaller values reduce memory usage, larger values reduce Poppler overhead
PDF_BATCH_SIZE=5
# Number of concurrent OCR threads per batch (default: 3, range: 1-10)
# Higher values speed up OCR but increase API load
OCR_CONCURRENCY=3

